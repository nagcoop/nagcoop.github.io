name: Update news

on:
  schedule:
    - cron: "17 9 * * *"   # every day, 06:17 Brasilia
  workflow_dispatch:        # "Run workflow" button to run it now

permissions:
  contents: write

concurrency:
  group: site-bots
  cancel-in-progress: false

jobs:
  news:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Fetch news
        run: python scripts/fetch_news.py

      - name: Publish news.json
        run: |
          git config user.name  "nagcoop-news-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add news.json
          if git diff --cached --quiet; then
            echo "No new stories."
          else
            git commit -m "News $(date -u +%Y-%m-%d)"
            git pull --rebase origin main
            git push
          fi
